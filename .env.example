# Copy to .env (never commit .env). Read by docker compose.

# Public HTTPS origin(s) allowed for cross-origin API calls. Leave EMPTY for the
# bundled UI: it is served from the same origin and needs no CORS (fail closed).
CORS_ORIGINS=

# One-time secret required by the first-run bootstrap (POST /auth/bootstrap).
# Generate:  openssl rand -base64 24
# If left empty on a fresh install the server generates one and logs it once.
BOOTSTRAP_TOKEN=

# true = administrators must enrol TOTP MFA before they can use the API.
# Enable after the first admin has enrolled (or enrol right after bootstrap).
REQUIRE_ADMIN_MFA=false

# debug | info | warn | error
LOG_LEVEL=info

# Only with compose.postgres.yml (use a long random value):
#   openssl rand -base64 32
POSTGRES_PASSWORD=

